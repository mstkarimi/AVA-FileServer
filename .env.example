# =============================================================================
# Sample environment file. Copy to `.env` and customize.
#   cp .env.example .env
# Or just run `./install.sh` which generates one for you.
# =============================================================================

# Token signing key. MUST be long and random.
# Generate with: openssl rand -hex 64
JWT_SECRET=replace-me-with-output-of-openssl-rand-hex-64

# --- Initial admin (only used the first time the DB is created) --------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# --- SFTP credentials --------------------------------------------------------
SFTP_USERNAME=ftpuser
SFTP_PASSWORD=change-this-too

# --- Public-facing base URL used to build share links (no trailing slash) ----
# Examples:
#   https://files.example.com
#   https://1.2.3.4:8082
PUBLIC_URL=https://localhost:8082

# --- Network bindings --------------------------------------------------------
# Default 0.0.0.0 publishes the container ports on every host interface.
# Set to 127.0.0.1 if you put the container behind a reverse proxy on the host.
BIND_ADDR=0.0.0.0
HTTPS_PORT=8082
SFTP_PORT=2222
